# server/.env 로 복사해서 쓰세요 (cp .env.example .env). .env 는 git 에 올리지 마세요.

# ── 공통 ─────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1              # 인터넷에 올릴 때(호스팅)는 0.0.0.0
# 인증번호·가입 토큰 서명용 비밀값(16자 이상 무작위). 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# 이 서버 말고 다른 주소(예: GitHub Pages)에서 API 를 부를 때 허용할 주소. 쉼표로 여러 개. 끝에 / 없이.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://25730070-collab.github.io
# NODE_ENV=production        # 올릴 때 켜면 APP_SECRET 이 없으면 시작하지 않아요
# TRUST_PROXY=1              # Render·Railway 처럼 앞에 프록시가 있을 때만 (IP 제한이 올바른 IP 를 보게)
# SERVE_STATIC=0             # API 만 제공 (화면은 GitHub Pages 가 보여 줄 때)

# ── 데이터베이스 ─────────────────────────────────────
# DB=sqlite 이면 설치 없이 server/dev.sqlite 파일을 써요(개발용). 실제로는 mysql.
DB=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=safedrive
MYSQL_PASSWORD=
MYSQL_DATABASE=safedrive
# MYSQL_SSL=1                # 클라우드 MySQL 은 보통 필요

# ── 메일 (비워 두면 메일을 보내지 않고 이 서버의 터미널에만 인증번호를 찍어요) ──
# Gmail 예: 구글 계정에서 2단계 인증을 켜고 '앱 비밀번호'를 만든 뒤 아래에 넣으세요 (평소 비밀번호가 아니에요)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587              # 465 를 쓰면 SMTP_SECURE=1
# SMTP_USER=내계정@gmail.com
# SMTP_PASSWORD=앱비밀번호16자리
# MAIL_FROM="Safe Drive <내계정@gmail.com>"

# ── 개발용 ───────────────────────────────────────────
# 메일 설정이 없을 때만 동작: 1 이면 인증번호를 화면에도 보여 줘요(발표 시연용). SMTP 가 켜져 있으면 무시돼요.
# DEV_SHOW_CODE=1
